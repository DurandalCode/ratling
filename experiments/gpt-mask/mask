#!/usr/bin/env bash
# Live-repo helper for the Mechanismus pipe (multi-product).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"
cmd="${1:-}"
shift || true
case "$cmd" in
  out|in|status|products)
    exec python3 experiments/gpt-mask/mask_sync.py "$cmd" "$@"
    ;;
  path)
    prod="${1:-${MASK_PRODUCT:-pistol}}"
    python3 -c "import sys; sys.path.insert(0,'experiments/gpt-mask'); from product_lib import load_product; print(load_product('$prod')['work_dir'])"
    ;;
  ""|-h|--help|help)
    cat <<'HELP'
Usage:
  experiments/gpt-mask/mask out    -p pistol|mitrailleuse|gatling [--force] [dir]
  experiments/gpt-mask/mask in     -p … [dir]
  experiments/gpt-mask/mask status -p …
  experiments/gpt-mask/mask products
  experiments/gpt-mask/mask path [product]

Default external dir: $MECHANISMUS or <repo-parent>/mechanismus (flat, no product subfolder)
HELP
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exit 1
    ;;
esac
